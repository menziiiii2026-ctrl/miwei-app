{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "food-diary/composition-intent.v1",
  "title": "Model-neutral Composition Intent",
  "type": "object",
  "required": ["version", "food_count", "ranked_template_codes", "background_id", "mood", "copy"],
  "properties": {
    "version": {"const": "composition-intent.v1"},
    "food_count": {"type": "integer", "minimum": 1, "maximum": 7},
    "ranked_template_codes": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "pattern": "^[1-6]_模板[1-3]$"}},
    "background_id": {"type": "string"},
    "mood": {
      "type": "object",
      "required": ["tags", "accent_color"],
      "properties": {
        "tags": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 5},
        "accent_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
      },
      "additionalProperties": false
    },
    "copy": {
      "type": "object",
      "properties": {
        "caption": {"type": "string", "maxLength": 42},
        "season": {"type": "string", "maxLength": 24},
        "date": {"type": "string", "maxLength": 24}
      },
      "additionalProperties": false
    },
    "reason": {"type": "string", "maxLength": 240}
  },
  "additionalProperties": false
}
